pkgname=hyprworks
pkgver=0.1.5
pkgrel=1

pkgdesc='Lua desktop shell toolkit for Hyprland'
arch=('x86_64')
url='https://github.com/more-yet/hyprworks'
license=('MIT' 'BSD-3-Clause' 'MIT-CMU')
options=('!debug')

depends=(
    'cairo'
    'glib2>=2.90.1'
    'glibc'
    'json-c>=0.19'
    'libgcc'
    'libpng'
    'libpulse>=17.0'
    'librsvg'
    'libstdc++'
    'libxkbcommon>=1.13.2'
    'lua>=5.5.1'
    'pango'
    'systemd-libs>=262'
    'wayland>=1.26.0'
)

makedepends=(
    'cmake>=4.5'
    'ninja'
    'pkgconf'
    'wayland-protocols>=1.45'
)

optdepends=(
    'hyprland: workspace integration and global shortcuts'
    'pulse-native-provider: audio control'
    'upower: power and battery information'
)

source=(
    "hyprworks-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)

sha256sums=('d9e013082537fc41e28a9f48e5a485ca19dfff0d90a096463b836cb115d6eec3')

build() {
    export CXXFLAGS="${CXXFLAGS} -ffile-prefix-map=${srcdir}=."

    cmake -S "hyprworks-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DHYPRWORKS_BUILD_TESTS=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "hyprworks-${pkgver}"/protocols/*.xml \
        -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
