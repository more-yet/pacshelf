#!/usr/bin/env bash

set -euo pipefail

[[ $# -eq 1 ]] || {
    printf 'error: expected one package artifact\n' >&2
    exit 1
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

archive="$1"

printf '==> Checking ChatGPT launcher invariants\n'

pkginfo="$(bsdtar -xOf "${archive}" .PKGINFO)"
listing="$(bsdtar -tf "${archive}")"

grep -Fqx 'pkgname = openai-chatgpt' <<< "${pkginfo}" ||
    fail 'unexpected package name'

for required in \
    'usr/bin/chatgpt' \
    'usr/share/applications/chatgpt.desktop' \
    'usr/share/chatgpt-launcher/release' \
    'usr/share/licenses/openai-chatgpt/LICENSE'
do
    grep -Fqx "${required}" <<< "${listing}" ||
        fail "missing required path: ${required}"
done

if grep -Eq '(^|/)chatgpt_.*_amd64\.deb$|^usr/lib/chatgpt/' <<< "${listing}"; then
    fail 'OpenAI vendor payload leaked into launcher package'
fi

desktop="$(bsdtar -xOf "${archive}" usr/share/applications/chatgpt.desktop)"
grep -Fqx 'Exec=chatgpt %U' <<< "${desktop}" ||
    fail 'unexpected desktop launcher command'

release="$(bsdtar -xOf "${archive}" usr/share/chatgpt-launcher/release)"
grep -Eq '^CHATGPT_SHA256=[[:xdigit:]]{64}$' <<< "${release}" ||
    fail 'release manifest lacks a pinned checksum'
grep -Eq '^CHATGPT_SIZE=[0-9]+$' <<< "${release}" ||
    fail 'release manifest lacks a pinned size'
release_size="$(awk -F= '$1 == "CHATGPT_SIZE" { print $2 }' <<< "${release}")"
(( release_size > 0 && release_size <= 629145600 )) ||
    fail 'release manifest exceeds the download size limit'

launcher="$(mktemp)"
trap 'rm -f "${launcher}"' EXIT
bsdtar -xOf "${archive}" usr/bin/chatgpt > "${launcher}"
bash -n "${launcher}"

printf '==> ChatGPT launcher invariants passed\n'
