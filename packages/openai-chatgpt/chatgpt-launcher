#!/usr/bin/env bash

set -euo pipefail

readonly release_file='/usr/share/chatgpt-launcher/release'
readonly max_archive_size_bytes=629145600

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

# shellcheck source=/dev/null
source "${release_file}"

[[ "${CHATGPT_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    fail 'invalid ChatGPT release version'
[[ "${CHATGPT_URL}" == "https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${CHATGPT_VERSION}_amd64.deb" ]] ||
    fail 'invalid ChatGPT release URL'
[[ "${CHATGPT_SHA256}" =~ ^[[:xdigit:]]{64}$ ]] ||
    fail 'invalid ChatGPT release checksum'
[[ "${CHATGPT_SIZE}" =~ ^[0-9]+$ ]] ||
    fail 'invalid ChatGPT release size'
(( CHATGPT_SIZE > 0 && CHATGPT_SIZE <= max_archive_size_bytes )) ||
    fail 'ChatGPT release exceeds the download size limit'

readonly data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
readonly install_root="${data_home}/chatgpt-launcher"
readonly install_dir="${install_root}/${CHATGPT_VERSION}-${CHATGPT_SHA256}"
readonly binary="${install_dir}/ChatGPT"
readonly archive_dir="${cache_home}/chatgpt-launcher"
readonly archive="${archive_dir}/chatgpt.deb"

verify_archive() {
    [[ -f "${archive}" ]] &&
        [[ "$(stat --format='%s' "${archive}")" == "${CHATGPT_SIZE}" ]] &&
        printf '%s  %s\n' "${CHATGPT_SHA256}" "${archive}" |
            sha256sum --check --status
}

install_chatgpt() (
    local -a data_archives
    local download=''
    local icon
    local old_install
    local staging=''

    trap '
        [[ -z "${download}" ]] || rm -f "${download}"
        [[ -z "${staging}" ]] || rm -rf "${staging}"
    ' EXIT

    if ! verify_archive; then
        download="$(mktemp "${archive}.part.XXXXXX")"
        curl \
            --fail \
            --location \
            --retry 3 \
            --connect-timeout 30 \
            --max-time 1800 \
            --max-filesize "${CHATGPT_SIZE}" \
            --proto '=https' \
            --proto-redir '=https' \
            --output "${download}" \
            "${CHATGPT_URL}"

        [[ "$(stat --format='%s' "${download}")" == "${CHATGPT_SIZE}" ]] ||
            fail 'ChatGPT download failed verification'
        printf '%s  %s\n' "${CHATGPT_SHA256}" "${download}" |
            sha256sum --check --status ||
            fail 'ChatGPT download failed verification'

        mv "${download}" "${archive}"
        download=''
    fi

    staging="$(mktemp -d "${install_root}/.install.XXXXXX")"
    mkdir -p "${staging}/deb" "${staging}/root"

    bsdtar -xf "${archive}" -C "${staging}/deb"

    shopt -s nullglob
    data_archives=("${staging}/deb"/data.tar.*)
    shopt -u nullglob

    (( ${#data_archives[@]} == 1 )) ||
        fail 'ChatGPT package contains an unexpected data archive'

    bsdtar -xf "${data_archives[0]}" -C "${staging}/root"
    [[ -x "${staging}/root/usr/lib/chatgpt/ChatGPT" ]] ||
        fail 'ChatGPT package does not contain the expected application'

    rm -rf "${install_dir}"
    mv "${staging}/root/usr/lib/chatgpt" "${install_dir}"

    icon="${staging}/root/usr/share/pixmaps/chatgpt.png"
    if [[ -f "${icon}" ]]; then
        install -Dm644 \
            "${icon}" \
            "${data_home}/icons/hicolor/512x512/apps/chatgpt.png"
    fi

    rm -rf "${staging}"
    staging=''

    for old_install in "${install_root}"/*; do
        [[ -d "${old_install}" ]] || continue
        [[ "${old_install}" == "${install_dir}" ]] || rm -rf "${old_install}"
    done
)

mkdir -p "${install_root}" "${archive_dir}"

exec {lock_fd}> "${install_root}/.lock"
flock --timeout 30 "${lock_fd}" ||
    fail 'timed out waiting for another ChatGPT installation'

if [[ ! -x "${binary}" ]]; then
    install_chatgpt
fi

flock --unlock "${lock_fd}"
exec {lock_fd}>&-

exec "${binary}" "$@"
