pkgname=openai-chatgpt
pkgver=26.1013.40934
pkgrel=1

pkgdesc='Runtime installer for the official ChatGPT desktop app'
arch=('x86_64')
url='https://developers.openai.com/codex/linux/linux-app'
license=('MIT')
options=('!debug')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'bash'
    'cairo'
    'coreutils'
    'curl'
    'dbus'
    'expat'
    'gdk-pixbuf2'
    'glib2'
    'glibc'
    'gtk3'
    'libarchive'
    'libcanberra'
    'libcups'
    'libdrm'
    'libgcc'
    'libglvnd'
    'libnotify'
    'libstdc++'
    'libusb'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'openssl'
    'pango'
    'systemd-libs'
    'tpm2-tss'
    'util-linux'
    'xdg-utils'
    'xz'
)

optdepends=(
    'git: local project version control'
    'org.freedesktop.secrets: credential storage'
    'vulkan-driver: hardware-accelerated Vulkan rendering'
)

provides=("chatgpt=${pkgver}")
conflicts=('chatgpt')

_deb="chatgpt_${pkgver}_amd64.deb"
_deb_url="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/${_deb}"
_max_deb_size=629145600

source=(
    'chatgpt-launcher'
    'chatgpt.desktop'
    'LICENSE'
    "${_deb}::${_deb_url}"
)

noextract=("${_deb}")

sha256sums=('fda6e835cb3e431fab52570a3868018e7769dbb39f2eb41a40ea9c7846df2808'
            '314abf317aaefebf47963356029f55319f5e43936848c270d0ad2c691d9edc1a'
            '6642f9005eabe54f989541fb8dec6251cf57dde29f3170f8b49e28069f6a55ec'
            '3ca59e7f9a6641b9e2fb9ad680683784b5ab8026ff7418fb212a0ebe5df3a1d7')

package() {
    local deb_size
    local release_file="${pkgdir}/usr/share/chatgpt-launcher/release"

    deb_size="$(stat --dereference --format='%s' "${_deb}")"
    (( deb_size > 0 && deb_size <= _max_deb_size )) || {
        printf 'error: ChatGPT package exceeds the download size limit\n' >&2
        return 1
    }

    install -Dm755 chatgpt-launcher "${pkgdir}/usr/bin/chatgpt"
    install -Dm644 chatgpt.desktop "${pkgdir}/usr/share/applications/chatgpt.desktop"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -dm755 "$(dirname "${release_file}")"
    printf 'CHATGPT_VERSION=%q\nCHATGPT_URL=%q\nCHATGPT_SHA256=%q\nCHATGPT_SIZE=%q\n' \
        "${pkgver}" \
        "${_deb_url}" \
        "${sha256sums[3]}" \
        "${deb_size}" \
        > "${release_file}"
    chmod 0644 "${release_file}"
}
