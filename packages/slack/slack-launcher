#!/usr/bin/env bash

set -euo pipefail
umask 077

source /usr/share/slack-launcher/release

readonly data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"

[[ "${data_home}" == /* && "${cache_home}" == /* ]] || {
    printf 'error: XDG data and cache directories must be absolute paths\n' >&2
    exit 1
}

readonly install_root="${data_home}/slack-launcher"
readonly install_dir="${install_root}/${SLACK_VERSION}-${SLACK_SHA256}"
readonly binary="${install_dir}/slack"
readonly archive_dir="${cache_home}/slack-launcher"
readonly archive="${archive_dir}/slack.deb"

mkdir -p "${install_root}" "${archive_dir}"
exec 9> "${install_root}/.lock"
flock --timeout 30 9

if [[ ! -x "${binary}" ]]; then
    staging="$(mktemp -d "${install_root}/.install.XXXXXX")"
    trap 'rm -rf "${staging}"' EXIT

    if [[ ! -f "${archive}" || -L "${archive}" ]] ||
        ! printf '%s  %s\n' "${SLACK_SHA256}" "${archive}" |
            sha256sum --check --status; then
        curl \
            --fail \
            --location \
            --retry 3 \
            --connect-timeout 30 \
            --max-time 1800 \
            --max-filesize "${SLACK_SIZE}" \
            --proto '=https' \
            --proto-redir '=https' \
            --output "${staging}/download.deb" \
            "${SLACK_URL}"

        printf '%s  %s\n' "${SLACK_SHA256}" "${staging}/download.deb" |
            sha256sum --check
        mv "${staging}/download.deb" "${archive}"
    fi

    mkdir -p "${staging}/deb" "${staging}/root"

    bsdtar -xf "${archive}" -C "${staging}/deb"

    shopt -s nullglob
    data_archives=("${staging}/deb"/data.tar.*)
    shopt -u nullglob

    (( ${#data_archives[@]} == 1 )) || {
        printf 'error: Slack package must contain one data archive\n' >&2
        exit 1
    }

    bsdtar -xf "${data_archives[0]}" -C "${staging}/root"

    app_dir="${staging}/root/usr/lib/slack"
    [[ -d "${app_dir}" && ! -L "${app_dir}" && -x "${app_dir}/slack" ]] || {
        printf 'error: Slack package does not contain the expected application\n' >&2
        exit 1
    }

    rm -f "${app_dir}/chrome-sandbox"
    chmod -R u-s,g-s,go-w "${app_dir}"

    rm -rf "${install_dir}"
    mv "${app_dir}" "${install_dir}"

    icon="${staging}/root/usr/share/pixmaps/slack.png"
    if [[ -f "${icon}" ]]; then
        install -Dm644 \
            "${icon}" \
            "${data_home}/icons/hicolor/512x512/apps/slack.png"
    fi

    rm -rf "${staging}"
    trap - EXIT

    for old_install in "${install_root}"/*; do
        [[ -d "${old_install}" ]] || continue
        [[ "${old_install}" == "${install_dir}" ]] || rm -rf "${old_install}"
    done
fi

flock --unlock 9
exec 9>&-

exec "${binary}" "$@"
