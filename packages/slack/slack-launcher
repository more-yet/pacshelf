#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly release_file='/usr/share/slack-launcher/release'

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

# shellcheck source=/dev/null
source "${release_file}"

[[ "${SLACK_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    fail 'invalid Slack release version'
[[ "${SLACK_URL}" == "https://downloads.slack-edge.com/desktop-releases/linux/x64/${SLACK_VERSION}/slack-desktop-${SLACK_VERSION}-amd64.deb" ]] ||
    fail 'invalid Slack release URL'
[[ "${SLACK_SHA256}" =~ ^[[:xdigit:]]{64}$ ]] ||
    fail 'invalid Slack release checksum'
[[ "${SLACK_SIZE}" =~ ^[1-9][0-9]*$ ]] ||
    fail 'invalid Slack release size'

readonly data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"

[[ "${data_home}" == /* && "${cache_home}" == /* ]] ||
    fail 'XDG data and cache directories must be absolute paths'

readonly install_root="${data_home}/slack-launcher"
readonly install_dir="${install_root}/${SLACK_VERSION}-${SLACK_SHA256}"
readonly binary="${install_dir}/slack"
readonly archive_dir="${cache_home}/slack-launcher"
readonly archive="${archive_dir}/slack.deb"

verify_archive() {
    [[ -f "${archive}" && ! -L "${archive}" ]] &&
        [[ "$(stat --format='%s' "${archive}")" == "${SLACK_SIZE}" ]] &&
        printf '%s  %s\n' "${SLACK_SHA256}" "${archive}" |
            sha256sum --check --status
}

install_slack() (
    local app_dir
    local -a data_archives
    local download=''
    local icon
    local old_install
    local staging=''

    trap '
        [[ -z "${download}" ]] || rm -f "${download}"
        [[ -z "${staging}" ]] || rm -rf "${staging}"
    ' EXIT

    if ! verify_archive; then
        download="$(mktemp "${archive}.part.XXXXXX")"
        curl \
            --fail \
            --location \
            --retry 3 \
            --connect-timeout 30 \
            --max-time 1800 \
            --max-filesize "${SLACK_SIZE}" \
            --proto '=https' \
            --proto-redir '=https' \
            --output "${download}" \
            "${SLACK_URL}"

        [[ "$(stat --format='%s' "${download}")" == "${SLACK_SIZE}" ]] ||
            fail 'Slack download failed verification'
        printf '%s  %s\n' "${SLACK_SHA256}" "${download}" |
            sha256sum --check --status ||
            fail 'Slack download failed verification'

        mv "${download}" "${archive}"
        download=''
    fi

    staging="$(mktemp -d "${install_root}/.install.XXXXXX")"
    mkdir -p "${staging}/deb" "${staging}/root"

    bsdtar -xf "${archive}" -C "${staging}/deb"

    shopt -s nullglob
    data_archives=("${staging}/deb"/data.tar.*)
    shopt -u nullglob

    (( ${#data_archives[@]} == 1 )) ||
        fail 'Slack package contains an unexpected data archive'

    bsdtar -xf "${data_archives[0]}" -C "${staging}/root"

    app_dir="${staging}/root/usr/lib/slack"
    [[ -d "${app_dir}" && ! -L "${app_dir}" && -x "${app_dir}/slack" ]] ||
        fail 'Slack package does not contain the expected application'

    # A user-owned setuid helper cannot provide Chromium's sandbox.
    rm -f "${app_dir}/chrome-sandbox"
    chmod -R u-s,g-s,go-w "${app_dir}"

    rm -rf "${install_dir}"
    mv "${app_dir}" "${install_dir}"

    icon="${staging}/root/usr/share/pixmaps/slack.png"
    if [[ -f "${icon}" ]]; then
        install -Dm644 \
            "${icon}" \
            "${data_home}/icons/hicolor/512x512/apps/slack.png"
    fi

    rm -rf "${staging}"
    staging=''

    for old_install in "${install_root}"/*; do
        [[ -d "${old_install}" ]] || continue
        [[ "${old_install}" == "${install_dir}" ]] || rm -rf "${old_install}"
    done
)

mkdir -p "${install_root}" "${archive_dir}"

exec {lock_fd}> "${install_root}/.lock"
flock --timeout 30 "${lock_fd}" ||
    fail 'timed out waiting for another Slack installation'

if [[ ! -x "${binary}" ]]; then
    install_slack
fi

flock --unlock "${lock_fd}"
exec {lock_fd}>&-

exec "${binary}" "$@"
