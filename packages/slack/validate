#!/usr/bin/env bash

set -euo pipefail

[[ $# -eq 1 ]] || {
    printf 'error: expected one package artifact\n' >&2
    exit 1
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

archive="$1"

printf '==> Checking Slack launcher invariants\n'

pkginfo="$(bsdtar -xOf "${archive}" .PKGINFO)"
listing="$(bsdtar -tf "${archive}")"

grep -Fqx 'pkgname = slack' <<< "${pkginfo}" ||
    fail 'unexpected package name'

for required in \
    'usr/bin/slack' \
    'usr/share/applications/slack.desktop' \
    'usr/share/licenses/slack/LICENSE' \
    'usr/share/slack-launcher/release'
do
    grep -Fqx "${required}" <<< "${listing}" ||
        fail "missing required path: ${required}"
done

if grep -Eq '(^|/)slack-desktop-.*\.deb$|^usr/lib/slack/' <<< "${listing}"; then
    fail 'Slack vendor payload leaked into launcher package'
fi

desktop="$(bsdtar -xOf "${archive}" usr/share/applications/slack.desktop)"
grep -Fqx 'Exec=slack %U' <<< "${desktop}" ||
    fail 'unexpected desktop launcher command'

launcher="$(mktemp)"
trap 'rm -f "${launcher}"' EXIT
bsdtar -xOf "${archive}" usr/bin/slack > "${launcher}"
bash -n "${launcher}"

printf '==> Slack launcher invariants passed\n'
