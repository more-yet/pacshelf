# Maintainer: Aditya Singh

pkgname=slack
pkgver=4.52.162
pkgrel=1

pkgdesc='Runtime installer for the official desktop client'
arch=('x86_64')
url='https://slack.com/downloads/linux'
license=('MIT')
options=('!debug')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'bash'
    'coreutils'
    'curl'
    'gtk3'
    'libappindicator'
    'libarchive'
    'libnotify'
    'libsecret'
    'libxkbfile'
    'libxss'
    'libxtst'
    'nss'
    'util-linux'
    'xdg-utils'
)

optdepends=(
    'org.freedesktop.secrets: credential storage'
)

provides=(
    "slack-desktop=${pkgver}"
)

conflicts=(
    'slack-desktop'
    'slack-desktop-wayland'
    'slack-electron'
)

_deb="slack-desktop-${pkgver}-amd64.deb"
_deb_url="https://downloads.slack-edge.com/desktop-releases/linux/x64/${pkgver}/slack-desktop-${pkgver}-amd64.deb"
_max_deb_size=314572800

source=(
    'slack-launcher'
    'slack.desktop'
    'LICENSE'
    "${_deb}::${_deb_url}"
)

noextract=("${_deb}")

sha256sums=('9610ff377b77250074d9de8475f262062c8f2c2f36e5ac5bf678944b10a5c539'
            'ea789ecac98b78251940dbf0c3cd94db1141db92a8666188a5e26f25cdf5bd26'
            '6642f9005eabe54f989541fb8dec6251cf57dde29f3170f8b49e28069f6a55ec'
            '5a1973ac9666889207787bf0e5330b62c6deddc3632ee6fcd3ece8c5eb823472')

package() {
    local deb_size
    local release_file="${pkgdir}/usr/share/slack-launcher/release"

    deb_size="$(stat --dereference --format='%s' "${_deb}")"
    (( deb_size > 0 && deb_size <= _max_deb_size )) || {
        printf 'error: Slack package exceeds the download size limit\n' >&2
        return 1
    }

    install -Dm755 slack-launcher "${pkgdir}/usr/bin/slack"
    install -Dm644 slack.desktop "${pkgdir}/usr/share/applications/slack.desktop"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -dm755 "$(dirname "${release_file}")"
    printf 'SLACK_VERSION=%q\nSLACK_URL=%q\nSLACK_SHA256=%q\nSLACK_SIZE=%q\n' \
        "${pkgver}" \
        "${_deb_url}" \
        "${sha256sums[3]}" \
        "${deb_size}" \
        > "${release_file}"
    chmod 0644 "${release_file}"
}
