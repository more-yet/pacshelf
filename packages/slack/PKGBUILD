# Maintainer: Aditya Singh

pkgname=slack
pkgver=4.52.155
pkgrel=1

pkgdesc='Runtime installer for the official desktop client'
arch=('x86_64')
url='https://slack.com/downloads/linux'
license=('MIT')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'bash'
    'coreutils'
    'curl'
    'gtk3'
    'libappindicator'
    'libarchive'
    'libnotify'
    'libsecret'
    'libxkbfile'
    'libxss'
    'libxtst'
    'nss'
    'util-linux'
    'xdg-utils'
)

optdepends=(
    'org.freedesktop.secrets: credential storage'
)

provides=(
    "slack-desktop=${pkgver}"
)

conflicts=(
    'slack-desktop'
    'slack-desktop-wayland'
    'slack-electron'
)

options=('!strip')

_deb="slack-desktop-${pkgver}-amd64.deb"
_deb_url="https://downloads.slack-edge.com/desktop-releases/linux/x64/${pkgver}/slack-desktop-${pkgver}-amd64.deb"

source=(
    'slack-launcher'
    'slack.desktop'
    'LICENSE'
    "${_deb}::${_deb_url}"
)

noextract=("${_deb}")

sha256sums=('ae2c9b4a9f5a7f189599c016e6df2da65ce8572a34226c046790fd40d0a93326'
            'ea789ecac98b78251940dbf0c3cd94db1141db92a8666188a5e26f25cdf5bd26'
            '6642f9005eabe54f989541fb8dec6251cf57dde29f3170f8b49e28069f6a55ec'
            '966536026f5afcd1c75a395dddd87b9596580931f659b40cebb21ab3add71b2f')

package() {
    local release_file="${pkgdir}/usr/share/slack-launcher/release"

    install -Dm755 slack-launcher "${pkgdir}/usr/bin/slack"
    install -Dm644 slack.desktop "${pkgdir}/usr/share/applications/slack.desktop"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -dm755 "$(dirname "${release_file}")"
    printf 'SLACK_VERSION=%q\nSLACK_URL=%q\nSLACK_SHA256=%q\n' \
        "${pkgver}" \
        "${_deb_url}" \
        "${sha256sums[3]}" \
        > "${release_file}"
    chmod 0644 "${release_file}"
}
