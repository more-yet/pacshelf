# Maintainer: Aditya Singh

pkgname=proton-pass
pkgver=1.42.0
pkgrel=1

pkgdesc='Open-source and secure identity manager'
arch=('x86_64')
url='https://proton.me/pass/download/linux'
license=('GPL-3.0-or-later' 'MIT')
options=('!debug' '!strip')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'libcups'
    'libdrm'
    'libgcc'
    'libnotify'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
)

conflicts=('proton-pass-bin')

source=("https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb")

sha512sums=('860550c8741da153494d381743226c9d44cfba42b381239f0f083336101d60e27340c10b00c2bcd2a0ec5cd8c226a4e8cb60508940b9cfdcc079584af035eec8')

package() {
    bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"

    install -Dm644 \
        "${pkgdir}/usr/share/doc/proton-pass/copyright" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    rm -r \
        "${pkgdir}/usr/share/doc" \
        "${pkgdir}/usr/share/lintian"

    chmod -R go-w "${pkgdir}/usr/lib/proton-pass"
    chmod 4755 "${pkgdir}/usr/lib/proton-pass/chrome-sandbox"
}
