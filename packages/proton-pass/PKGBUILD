pkgname=proton-pass
pkgver=1.43.1
pkgrel=1

pkgdesc='Open-source and secure identity manager'
arch=('x86_64')
url='https://proton.me/pass/download/linux'
license=('GPL-3.0-or-later' 'MIT')
options=('!debug' '!strip')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'libcups'
    'libdrm'
    'libgcc'
    'libnotify'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
)

conflicts=('proton-pass-bin')

source=("https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb")

sha512sums=('0060237052fca72d74f985f6d93a0943c97a83592df368ee2516ebacc057de4f451fc8b8458f367f311bd5700da5849d815b3ccc8543718dbb22f80bd3cd949b')

package() {
    bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"

    install -Dm644 \
        "${pkgdir}/usr/share/doc/proton-pass/copyright" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    rm -r \
        "${pkgdir}/usr/share/doc" \
        "${pkgdir}/usr/share/lintian"

    chmod -R go-w "${pkgdir}/usr/lib/proton-pass"
    chmod 4755 "${pkgdir}/usr/lib/proton-pass/chrome-sandbox"
}
