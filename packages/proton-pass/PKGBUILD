pkgname=proton-pass
pkgver=1.43.0
pkgrel=1

pkgdesc='Open-source and secure identity manager'
arch=('x86_64')
url='https://proton.me/pass/download/linux'
license=('GPL-3.0-or-later' 'MIT')
options=('!debug' '!strip')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'libcups'
    'libdrm'
    'libgcc'
    'libnotify'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
)

conflicts=('proton-pass-bin')

source=("https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb")

sha512sums=('ac19002dd7e5e6110fd5ca5d342d2cacbd2528d95966e83c1ac8df928e86506927d9cad1ffafaa1b542bb6ebf13aaa8f7b5e6d6499531a62aa82bbf82a706c62')

package() {
    bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"

    install -Dm644 \
        "${pkgdir}/usr/share/doc/proton-pass/copyright" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    rm -r \
        "${pkgdir}/usr/share/doc" \
        "${pkgdir}/usr/share/lintian"

    chmod -R go-w "${pkgdir}/usr/lib/proton-pass"
    chmod 4755 "${pkgdir}/usr/lib/proton-pass/chrome-sandbox"
}
