# Maintainer: Aditya Singh

pkgname=proton-pass
pkgver=1.40.2
pkgrel=1

pkgdesc='Open-source and secure identity manager'
arch=('x86_64')
url='https://proton.me/pass/download/linux'
license=('GPL-3.0-or-later' 'MIT')
options=('!debug' '!strip')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'libcups'
    'libdrm'
    'libgcc'
    'libnotify'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
)

conflicts=('proton-pass-bin')

source=("https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb")

sha512sums=('c9bd58a7266dc78fd33da6b7c127930424e47277c9db8a521b079c68557e33e510f02fb8c3db26190f31ae3a14bb3951bf498a41b73a3fdd021376e24653a78a')

package() {
    bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"

    install -Dm644 \
        "${pkgdir}/usr/share/doc/proton-pass/copyright" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    rm -r \
        "${pkgdir}/usr/share/doc" \
        "${pkgdir}/usr/share/lintian"

    chmod -R go-w "${pkgdir}/usr/lib/proton-pass"
}
