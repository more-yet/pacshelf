# Maintainer: Aditya Singh

pkgname=proton-pass
pkgver=1.41.1
pkgrel=1

pkgdesc='Open-source and secure identity manager'
arch=('x86_64')
url='https://proton.me/pass/download/linux'
license=('GPL-3.0-or-later' 'MIT')
options=('!debug' '!strip')

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'libcups'
    'libdrm'
    'libgcc'
    'libnotify'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
)

conflicts=('proton-pass-bin')

source=("https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb")

sha512sums=('a4bb0e90270d0fde7beb2aa7a99a1595fc3bc3fbe1ae0062e842d387cdd46a17c24c5b36dd35a3fa37bd6b879dba123b5e7d4a7a3cf679236e1b8b5e416b34c2')

package() {
    bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"

    install -Dm644 \
        "${pkgdir}/usr/share/doc/proton-pass/copyright" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    rm -r \
        "${pkgdir}/usr/share/doc" \
        "${pkgdir}/usr/share/lintian"

    chmod -R go-w "${pkgdir}/usr/lib/proton-pass"
    chmod 4755 "${pkgdir}/usr/lib/proton-pass/chrome-sandbox"
}
