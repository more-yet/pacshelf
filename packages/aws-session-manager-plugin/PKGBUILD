# Maintainer: Aditya Singh

pkgname=aws-session-manager-plugin
pkgver=1.2.835.0
pkgrel=2

pkgdesc='AWS Systems Manager Session Manager plugin'
arch=('x86_64')
url='https://github.com/aws/session-manager-plugin'
license=('Apache-2.0')

depends=(
    'glibc'
)

optdepends=(
    'aws-cli: AWS CLI v1 integration'
    'aws-cli-v2: AWS CLI v2 integration'
)

provides=(
    "session-manager-plugin=${pkgver}"
)

conflicts=(
    'session-manager-plugin'
)

options=(
    '!strip'
)

_deb="session-manager-plugin-${pkgver}-amd64.deb"

source=(
    "${_deb}::https://s3.amazonaws.com/session-manager-downloads/plugin/${pkgver}/ubuntu_64bit/session-manager-plugin.deb"
)

noextract=("${_deb}")

# KEEP THE REAL HASH GENERATED BY updpkgsums HERE.
sha256sums=('7c6dcad12518571cc7959a713e6a8ae1bdf6ed66fd9bee37dc189e39ca58ae03')

prepare() {
    rm -rf \
        "${srcdir}/deb" \
        "${srcdir}/root"

    mkdir -p \
        "${srcdir}/deb" \
        "${srcdir}/root"

    bsdtar -xf \
        "${srcdir}/${_deb}" \
        -C "${srcdir}/deb"

    local data_archive

    data_archive="$(
        find "${srcdir}/deb" \
            -maxdepth 1 \
            -type f \
            -name 'data.tar.*' \
            -print \
            -quit
    )"

    if [[ -z "${data_archive}" ]]; then
        printf '%s\n' \
            'Could not find data.tar.* in AWS Session Manager package' >&2
        return 1
    fi

    bsdtar -xf \
        "${data_archive}" \
        -C "${srcdir}/root"
}

package() {
    local upstream="${srcdir}/root/usr/local/sessionmanagerplugin"
    local runtime="${pkgdir}/usr/lib/aws-session-manager-plugin"

    #
    # Runtime
    #
    install -Dm755 \
        "${upstream}/bin/session-manager-plugin" \
        "${runtime}/bin/session-manager-plugin"

    #
    # Keep runtime metadata/config beside the upstream binary.
    #
    install -Dm644 \
        "${upstream}/VERSION" \
        "${runtime}/VERSION"

    install -Dm644 \
        "${upstream}/seelog.xml.template" \
        "${runtime}/seelog.xml.template"

    #
    # Standard executable location.
    #
    install -d "${pkgdir}/usr/bin"

    ln -s \
        ../lib/aws-session-manager-plugin/bin/session-manager-plugin \
        "${pkgdir}/usr/bin/session-manager-plugin"

    #
    # Documentation.
    #
    install -Dm644 \
        "${upstream}/README.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    install -Dm644 \
        "${upstream}/RELEASENOTES.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/RELEASENOTES.md"

    install -Dm644 \
        "${upstream}/NOTICE" \
        "${pkgdir}/usr/share/doc/${pkgname}/NOTICE"

    install -Dm644 \
        "${upstream}/THIRD-PARTY" \
        "${pkgdir}/usr/share/doc/${pkgname}/THIRD-PARTY"

    #
    # License.
    #
    install -Dm644 \
        "${upstream}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
