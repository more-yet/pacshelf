#!/usr/bin/env bash

set -euo pipefail

[[ $# -ge 1 ]] || {
    printf 'error: no package artifact supplied\n' >&2
    exit 1
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

for archive in "$@"; do
    printf '==> Checking AWS Session Manager Plugin invariants\n'

    listing="$(bsdtar -tf "${archive}")"

    for required in \
        'usr/bin/session-manager-plugin' \
        'usr/lib/aws-session-manager-plugin/bin/session-manager-plugin' \
        'usr/lib/aws-session-manager-plugin/VERSION' \
        'usr/lib/aws-session-manager-plugin/seelog.xml.template' \
        'usr/share/licenses/aws-session-manager-plugin/LICENSE'
    do
        grep -Fqx "${required}" <<< "${listing}" ||
            fail "missing required path: ${required}"
    done

    for forbidden in \
        'usr/local/' \
        'etc/init/' \
        'lib/systemd/system/session-manager-plugin.service' \
        'usr/share/lintian/'
    do
        if grep -Fq "${forbidden}" <<< "${listing}"; then
            fail "forbidden upstream packaging path present: ${forbidden}"
        fi
    done

    verbose="$(bsdtar -tvf "${archive}")"

    grep -Fq \
        'usr/bin/session-manager-plugin -> ../lib/aws-session-manager-plugin/bin/session-manager-plugin' \
        <<< "${verbose}" ||
        fail 'unexpected session-manager-plugin symlink'

    tmp="$(mktemp)"
    trap 'rm -f "${tmp}"' EXIT

    bsdtar -xOf \
        "${archive}" \
        usr/lib/aws-session-manager-plugin/bin/session-manager-plugin \
        > "${tmp}"

    chmod +x "${tmp}"

    expected="$(
        bsdtar -xOf \
            "${archive}" \
            usr/lib/aws-session-manager-plugin/VERSION |
        tr -d '\r\n'
    )"

    actual="$("${tmp}" --version | tr -d '\r\n')"

    [[ "${actual}" == "${expected}" ]] ||
        fail "binary version mismatch: expected ${expected}, got ${actual}"

    printf '==> AWS Session Manager Plugin invariants passed\n'
done
