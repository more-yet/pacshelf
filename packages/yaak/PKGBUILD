# Contributor: DeepChirp <deepchirp@archlinux.org>
# Contributor: Jonas Geiler <aur@jonasgeiler.com>
# Contributor: SoftExpert <softexpert at gmail dot com>

pkgname=yaak
pkgver=2026.6.0
pkgrel=3

pkgdesc='A fast, secure, and offline API client'
arch=('x86_64')
url='https://yaak.app/'
license=('MIT')

depends=(
    'bzip2'
    'cairo'
    'dbus'
    'fontconfig'
    'gdk-pixbuf2'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libgcc'
    'libgit2'
    'libsoup3'
    'libssh2'
    'nodejs'
    'openssl'
    'protobuf'
    'sqlite'
    'webkit2gtk-4.1'
    'xz'
    'zstd'
)

makedepends=(
    'appmenu-gtk-module'
    'cargo'
    'git'
    'imagemagick'
    'libappindicator-gtk3'
    'librsvg'
    'npm'
    'rust-wasm'
    'wasm-pack'
)

optdepends=(
    'yaak-cli: CLI management paired with AI agents'
)

provides=(
    'yaak-app'
    'yaak-app-client'
)

options=('!lto')

source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/mountain-loop/yaak/archive/refs/tags/v${pkgver}.tar.gz"
    'app.yaak.Yaak.desktop'
)

sha256sums=(
    'efcfb8e7364e72c80a89ba923fb43f8516aa86a415291b2499fa7c2d4da67761'
    '228dc02b9ffecef06195e67d5d7d70b1fd64546682ced382cb448f35039997f8'
)

_setup_env() {
    export YAAK_VERSION="${pkgver}"
    export CI=true

    export LIBGIT2_NO_VENDOR=1
    export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
    export LIBSSH2_SYS_USE_PKG_CONFIG=1
    export OPENSSL_NO_VENDOR=1
    export ZSTD_SYS_USE_PKG_CONFIG=1

    export CARGO_PROFILE_RELEASE_LTO=true
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
}

prepare() {
    cd "${pkgname}-${pkgver}"

    printf '%s\n' "console.log('Skipped NodeJS download for Arch Linux');" \
        > scripts/vendor-node.cjs
    mkdir -p "crates-tauri/yaak-app-client/vendored/node"
    touch "crates-tauri/yaak-app-client/vendored/node/yaaknode"

    printf '%s\n' "console.log('Skipped Protoc download for Arch Linux');" \
        > scripts/vendor-protoc.cjs
    mkdir -p "crates-tauri/yaak-app-client/vendored/protoc/include/google"
    touch "crates-tauri/yaak-app-client/vendored/protoc/yaakprotoc"
    ln -sf \
        '/usr/include/google/protobuf' \
        'crates-tauri/yaak-app-client/vendored/protoc/include/google/protobuf'

    npm ci
}

build() {
    cd "${pkgname}-${pkgver}"
    _setup_env

    npm run replace-version

    pushd 'crates-tauri/yaak-app-client'
    npx tauri build
    popd

    local icon_source='crates-tauri/yaak-app-client/icons/icon.png'

    mkdir -p "${srcdir}/icons-build"

    for resolution in 16 24 32 48 64 128 256 512 1024; do
        magick \
            "${icon_source}" \
            -resize "${resolution}x${resolution}" \
            "${srcdir}/icons-build/yaak-app-client-${resolution}.png"
    done
}

check() {
    cd "${pkgname}-${pkgver}"
    _setup_env

    npm test
    cargo test --frozen -p yaak-app-client --features wry
}

package() {
    cd "${pkgname}-${pkgver}"

    install -Dm755 \
        'target/release/yaak-app-client' \
        "${pkgdir}/usr/bin/yaak-app-client"

    install -d "${pkgdir}/usr/lib/${pkgname}"
    cp -r \
        'crates-tauri/yaak-app-client/static' \
        "${pkgdir}/usr/lib/${pkgname}/"

    install -d "${pkgdir}/usr/lib/${pkgname}/vendored"
    cp -r \
        'crates-tauri/yaak-app-client/vendored/plugins' \
        'crates-tauri/yaak-app-client/vendored/plugin-runtime' \
        "${pkgdir}/usr/lib/${pkgname}/vendored/"

    install -d "${pkgdir}/usr/lib/${pkgname}/vendored/node"
    ln -s \
        '/usr/bin/node' \
        "${pkgdir}/usr/lib/${pkgname}/vendored/node/yaaknode"

    install -d "${pkgdir}/usr/lib/${pkgname}/vendored/protoc/include/google"
    ln -s \
        '/usr/bin/protoc' \
        "${pkgdir}/usr/lib/${pkgname}/vendored/protoc/yaakprotoc"
    ln -s \
        '/usr/include/google/protobuf' \
        "${pkgdir}/usr/lib/${pkgname}/vendored/protoc/include/google/protobuf"

    for resolution in 16 24 32 48 64 128 256 512 1024; do
        install -Dm644 \
            "${srcdir}/icons-build/yaak-app-client-${resolution}.png" \
            "${pkgdir}/usr/share/icons/hicolor/${resolution}x${resolution}/apps/yaak-app-client.png"
    done

    install -Dm644 \
        'flatpak/app.yaak.Yaak.metainfo.xml' \
        "${pkgdir}/usr/share/metainfo/app.yaak.Yaak.metainfo.xml"

    install -Dm644 \
        "${srcdir}/app.yaak.Yaak.desktop" \
        "${pkgdir}/usr/share/applications/app.yaak.Yaak.desktop"

    install -Dm644 \
        'LICENSE' \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
