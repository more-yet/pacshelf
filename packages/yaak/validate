#!/usr/bin/env bash

set -euo pipefail

[[ $# -ge 1 ]] || {
    printf 'error: no package artifact supplied\n' >&2
    exit 1
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

for archive in "$@"; do
    printf '==> Checking Yaak package invariants\n'

    pkginfo="$(bsdtar -xOf "${archive}" .PKGINFO)"
    grep -Fqx 'pkgname = yaak' <<< "${pkginfo}" ||
        fail 'unexpected package name'

    listing="$(bsdtar -tf "${archive}")"

    for required in \
        'usr/bin/yaak-app-client' \
        'usr/lib/yaak/static/greg.jpeg' \
        'usr/lib/yaak/vendored/node/yaaknode' \
        'usr/lib/yaak/vendored/protoc/yaakprotoc' \
        'usr/share/applications/app.yaak.Yaak.desktop' \
        'usr/share/licenses/yaak/LICENSE'
    do
        grep -Fqx "${required}" <<< "${listing}" ||
            fail "missing required path: ${required}"
    done

    desktop="$(
        bsdtar -xOf \
            "${archive}" \
            usr/share/applications/app.yaak.Yaak.desktop
    )"

    grep -Fqx 'Exec=yaak-app-client %U' <<< "${desktop}" ||
        fail 'unexpected Yaak desktop launcher command'

    verbose_listing="$(bsdtar -tvf "${archive}")"

    grep -Fq \
        'usr/lib/yaak/vendored/node/yaaknode -> /usr/bin/node' \
        <<< "${verbose_listing}" ||
        fail 'Yaak does not use the system Node.js executable'

    grep -Fq \
        'usr/lib/yaak/vendored/protoc/yaakprotoc -> /usr/bin/protoc' \
        <<< "${verbose_listing}" ||
        fail 'Yaak does not use the system Protoc executable'

    printf '==> Yaak package invariants passed\n'
done
