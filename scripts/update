#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=/dev/null
source "${root}/scripts/common"

[[ $# -eq 1 ]] || {
    printf 'Usage: %s <package>\n' "$(basename "$0")" >&2
    exit 2
}

package_name="$1"
require_package_name "${package_name}"
acquire_repository_lock "${root}"

package_dir="${root}/packages/${package_name}"

if [[ ! -f "${package_dir}/PKGBUILD" ]]; then
    printf 'error: package not found: %s\n' "${package_name}" >&2
    exit 1
fi

if [[ ! -f "${package_dir}/.nvchecker.toml" ]]; then
    printf 'error: missing .nvchecker.toml for %s\n' "${package_name}" >&2
    exit 1
fi

cd "${package_dir}"

printf '==> Checking upstream: %s\n' "${package_name}"

set +e
# pkgctl disowns its spinner, so do not let that child extend the lock lifetime.
pkgctl version check -v 9>&-
status=$?
set -e

case "${status}" in
    0)
        printf '==> Already up-to-date: %s\n' "${package_name}"
        exit 0
        ;;

    2)
        printf '==> New upstream version found: %s\n' "${package_name}"
        ;;

    *)
        printf 'error: pkgctl version check failed with status %d\n' \
            "${status}" >&2
        exit 1
        ;;
esac

printf '==> Updating PKGBUILD: %s\n' "${package_name}"

pkgctl version upgrade -v 9>&-

printf '==> Regenerating .SRCINFO\n'

srcinfo_tmp="$(mktemp "${package_dir}/.SRCINFO.tmp.XXXXXX")"
trap 'rm -f "${srcinfo_tmp}"' EXIT

makepkg --printsrcinfo > "${srcinfo_tmp}"
chmod 0644 "${srcinfo_tmp}"
mv "${srcinfo_tmp}" .SRCINFO
srcinfo_tmp=''

printf '==> Updated: %s\n' "${package_name}"
