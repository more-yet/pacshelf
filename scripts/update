#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

(( $# <= 1 )) || {
    printf 'Usage: %s [package]\n' "$(basename "$0")" >&2
    exit 2
}

selection="${1:-all}"
mkdir -p "${root}/.cache/sources"
export SRCDEST="${root}/.cache/sources"

pkgbuilds=("${root}"/packages/*/PKGBUILD)
if [[ "${selection}" != all ]]; then
    pkgbuilds=("${root}/packages/${selection}/PKGBUILD")
fi

if [[ ! "${selection}" =~ ^[a-z0-9@._+-]+$ || ! -f "${pkgbuilds[0]}" ]]; then
    printf 'error: package not found: %s\n' "${selection}" >&2
    exit 1
fi

work_dir="$(mktemp -d "${root}/.cache/update.XXXXXX")"
trap 'rm -rf "${work_dir}"' EXIT

for pkgbuild in "${pkgbuilds[@]}"; do
    cd "${pkgbuild%/*}"
    pkgctl version upgrade -v
    makepkg --printsrcinfo > "${work_dir}/.SRCINFO"
    chmod 0644 "${work_dir}/.SRCINFO"
    mv "${work_dir}/.SRCINFO" .SRCINFO
done

awk '
    /^## Packages$/ { exit }
    { print }
' "${root}/README.md" > "${work_dir}/README.md"

{
    printf '## Packages\n\n| Package | Version |\n| --- | --- |\n'
    for pkgbuild in "${root}"/packages/*/PKGBUILD; do
        package_dir="${pkgbuild%/*}"
        awk -v package="${package_dir##*/}" '
            $1 == "pkgver" { version = $3 }
            $1 == "pkgrel" { release = $3 }
            END {
                if (version == "" || release == "") {
                    printf "error: missing version metadata in %s\n", FILENAME > "/dev/stderr"
                    exit 1
                }
                printf "| [`%s`](packages/%s) | `%s-%s` |\n", package, package, version, release
            }
        ' "${package_dir}/.SRCINFO"
    done
} >> "${work_dir}/README.md"

chmod 0644 "${work_dir}/README.md"
mv "${work_dir}/README.md" "${root}/README.md"
