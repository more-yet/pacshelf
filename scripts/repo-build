#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=/dev/null
source "${root}/config/repo.conf"

[[ $# -eq 1 ]] || {
    printf 'Usage: %s <package>\n' "$(basename "$0")" >&2
    exit 2
}

package_name="$1"
package_dir="${root}/packages/${package_name}"
artifact_dir="${root}/.cache/artifacts/${REPO_ARCH}"
repo_dir="${root}/repo/${REPO_ARCH}"

if [[ ! -f "${package_dir}/PKGBUILD" ]]; then
    printf 'error: package not found: %s\n' "${package_name}" >&2
    exit 1
fi

export PKGDEST="${artifact_dir}"

mkdir -p "${repo_dir}"

cd "${package_dir}"

mapfile -t built_packages < <(makepkg --packagelist)

published=()

for package_file in "${built_packages[@]}"; do
    [[ -f "${package_file}" ]] || {
        printf 'error: artifact missing: %s\n' "${package_file}" >&2
        exit 1
    }

    signature="${package_file}.sig"

    [[ -f "${signature}" ]] || {
        printf 'error: package signature missing: %s\n' "${signature}" >&2
        exit 1
    }

    destination="${repo_dir}/$(basename "${package_file}")"
    destination_signature="${destination}.sig"

    if [[ -e "${destination}" ]] && ! cmp -s "${package_file}" "${destination}"; then
        printf 'error: refusing to replace published artifact: %s\n' \
            "${destination}" >&2
        exit 1
    fi

    if [[ -e "${destination_signature}" ]] && \
        ! cmp -s "${signature}" "${destination_signature}"
    then
        printf 'error: refusing to replace published signature: %s\n' \
            "${destination_signature}" >&2
        exit 1
    fi

    install -Dm644 "${package_file}" "${destination}"
    install -Dm644 "${signature}" "${destination}.sig"

    published+=("${destination}")
done

repo-add \
    --prevent-downgrade \
    --include-sigs \
    "${repo_dir}/${REPO_NAME}.db.tar.zst" \
    "${published[@]}"

rm -f \
    "${repo_dir}/${REPO_NAME}.db.tar.zst.old" \
    "${repo_dir}/${REPO_NAME}.files.tar.zst.old"

printf '==> Repository updated: %s\n' "${REPO_NAME}"
