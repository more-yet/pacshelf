#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

(( $# <= 1 )) || {
    printf 'Usage: %s [package]\n' "$(basename "$0")" >&2
    exit 2
}

selection="${1:-all}"
artifact_dir="${root}/.cache/artifacts/x86_64"

mkdir -p \
    "${root}/.cache/sources" \
    "${root}/.cache/build" \
    "${artifact_dir}"

export PKGDEST="${artifact_dir}"
export SRCDEST="${root}/.cache/sources"
export BUILDDIR="${root}/.cache/build"

pkgbuilds=("${root}"/packages/*/PKGBUILD)
if [[ "${selection}" != all ]]; then
    pkgbuilds=("${root}/packages/${selection}/PKGBUILD")
fi

if [[ ! "${selection}" =~ ^[a-z0-9@._+-]+$ || ! -f "${pkgbuilds[0]}" ]]; then
    printf 'error: package not found: %s\n' "${selection}" >&2
    exit 1
fi

for pkgbuild in "${pkgbuilds[@]}"; do
    cd "${pkgbuild%/*}"

    if ! diff -u .SRCINFO <(makepkg --printsrcinfo); then
        printf 'error: regenerate %s/.SRCINFO\n' "${PWD}" >&2
        exit 1
    fi

    printf '==> Building: %s\n' "${PWD##*/}"

    makepkg \
        --syncdeps \
        --noconfirm \
        --cleanbuild \
        --clean \
        --force

    package_list="$(makepkg --packagelist)"
    while IFS= read -r package_file; do
        rm -f "${package_file}.sig"
        printf '==> Built: %s\n' "${package_file}"
    done <<< "${package_list}"
done
