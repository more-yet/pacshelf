#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=/dev/null
source "${root}/scripts/common"

# shellcheck source=/dev/null
source "${root}/config/repo.conf"

[[ $# -eq 1 ]] || {
    printf 'Usage: %s <package>\n' "$(basename "$0")" >&2
    exit 2
}

package_name="$1"
require_package_name "${package_name}"
acquire_repository_lock "${root}"

package_dir="${root}/packages/${package_name}"

cache_dir="${root}/.cache"
source_dir="${cache_dir}/sources"
build_dir="${cache_dir}/build"
artifact_dir="${cache_dir}/artifacts/${REPO_ARCH}"

if [[ ! -f "${package_dir}/PKGBUILD" ]]; then
    printf 'error: package not found: %s\n' "${package_name}" >&2
    exit 1
fi

mkdir -p \
    "${source_dir}" \
    "${build_dir}" \
    "${artifact_dir}"

export PKGDEST="${artifact_dir}"
export SRCDEST="${source_dir}"
export BUILDDIR="${build_dir}"

cd "${package_dir}"

tmp_srcinfo="$(mktemp)"
trap 'rm -f "${tmp_srcinfo}"' EXIT

makepkg --printsrcinfo > "${tmp_srcinfo}"

if ! cmp -s .SRCINFO "${tmp_srcinfo}"; then
    printf '%s\n' \
        'error: .SRCINFO is out of sync with PKGBUILD' >&2
    exit 1
fi

printf '==> Building: %s\n' "${package_name}"

makepkg \
    --syncdeps \
    --noconfirm \
    --cleanbuild \
    --clean \
    --force

if ! package_list="$(
    makepkg --packagelist |
        bounded_lines "${REPO_MAX_PACKAGE_ARTIFACTS}"
)"; then
    printf 'error: could not enumerate package artifacts: %s\n' \
        "${package_name}" >&2
    exit 1
fi

[[ -n "${package_list}" ]] || {
    printf 'error: package produced no artifact paths: %s\n' \
        "${package_name}" >&2
    exit 1
}

mapfile -t built_packages <<< "${package_list}"

for package_file in "${built_packages[@]}"; do
    [[ -f "${package_file}" && ! -L "${package_file}" ]] || {
        printf 'error: expected artifact missing: %s\n' \
            "${package_file}" >&2
        exit 1
    }

    package_size="$(stat --format='%s' "${package_file}")"
    (( package_size <= REPO_MAX_ARTIFACT_BYTES )) || {
        rm -f "${package_file}" "${package_file}.sig"
        printf 'error: package artifact exceeds size limit: %s\n' \
            "${package_file}" >&2
        exit 1
    }

    rm -f "${package_file}.sig"
    printf '==> Built: %s\n' "${package_file}"
done

"${root}/scripts/prune" cache "${built_packages[@]}"
