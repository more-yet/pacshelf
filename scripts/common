#!/usr/bin/env bash

require_package_name() {
    local package_name="$1"

    [[ "${package_name}" =~ ^[a-zA-Z0-9@._+-]+$ ]] &&
        [[ "${package_name}" != . && "${package_name}" != .. ]] || {
        printf 'error: invalid package name: %s\n' "${package_name}" >&2
        return 2
    }
}

acquire_repository_lock() {
    local root="$1"
    local lock_file="${root}/.cache/release.lock"

    mkdir -p "${root}/.cache"

    if [[ "$(readlink "/proc/${BASHPID}/fd/9" 2>/dev/null || true)" != "${lock_file}" ]]; then
        exec 9> "${lock_file}"
    fi

    flock -n 9 || {
        printf '%s\n' 'error: another repository operation is already running' >&2
        return 1
    }
}

bounded_archive_listing() {
    local archive="$1"
    local max_entries="$2"

    bsdtar -tf "${archive}" |
        LC_ALL=C awk -v max_entries="${max_entries}" '
            NR > max_entries { exit 1 }
            { print }
        '
}

bounded_lines() {
    local max_lines="$1"

    LC_ALL=C awk -v max_lines="${max_lines}" '
        NR > max_lines { exit 1 }
        { print }
    '
}

verify_detached_signature() {
    local artifact="$1"
    local signature="$2"
    local expected_fingerprint="${3^^}"
    local signature_size
    local signature_status
    local signer

    [[ -f "${artifact}" && ! -L "${artifact}" ]] || return 1
    [[ -f "${signature}" && ! -L "${signature}" ]] || return 1

    signature_size="$(stat --format='%s' "${signature}")" || return 1
    (( signature_size > 0 && signature_size <= 16384 )) ||
        return 1

    signature_status="$(
        gpg --batch --status-fd 1 \
            --verify "${signature}" "${artifact}" 2>/dev/null
    )" || return 1

    signer="$(
        awk '
            $1 == "[GNUPG:]" && $2 == "VALIDSIG" {
                print toupper($NF)
                exit
            }
        ' <<< "${signature_status}"
    )"

    [[ "${signer}" == "${expected_fingerprint}" ]]
}
