#!/usr/bin/env bash

require_package_name() {
    local package_name="$1"

    [[ "${package_name}" =~ ^[a-zA-Z0-9@._+-]+$ ]] &&
        [[ "${package_name}" != . && "${package_name}" != .. ]] || {
        printf 'error: invalid package name: %s\n' "${package_name}" >&2
        return 2
    }
}

acquire_repository_lock() {
    local root="$1"
    local lock_file="${root}/.cache/release.lock"

    mkdir -p "${root}/.cache"

    if [[ "$(readlink "/proc/${BASHPID}/fd/9" 2>/dev/null || true)" != "${lock_file}" ]]; then
        exec 9> "${lock_file}"
    fi

    flock -n 9 || {
        printf '%s\n' 'error: another repository operation is already running' >&2
        return 1
    }
}

bounded_archive_listing() {
    local archive="$1"
    local max_entries="$2"

    bsdtar -tf "${archive}" |
        LC_ALL=C awk -v max_entries="${max_entries}" '
            NR > max_entries { exit 1 }
            { print }
        '
}

bounded_lines() {
    local max_lines="$1"

    LC_ALL=C awk -v max_lines="${max_lines}" '
        NR > max_lines { exit 1 }
        { print }
    '
}
