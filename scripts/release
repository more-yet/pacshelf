#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo_name='pacshelf'
repo_arch='x86_64'
repo_remote='r2:pacshelf'
signing_key='9243E163FD44CCF22FF9C29E6F582689B321A703'

[[ $# -eq 1 ]] || {
    printf 'Usage: %s <package|all>\n' "$(basename "$0")" >&2
    exit 2
}

selection="$1"
repo_root="${root}/repo"
repo_dir="${repo_root}/${repo_arch}"
remote_dir="${repo_remote}/${repo_arch}"
export PKGDEST="${root}/.cache/artifacts/${repo_arch}"

pkgbuilds=("${root}"/packages/*/PKGBUILD)
if [[ "${selection}" != all ]]; then
    pkgbuilds=("${root}/packages/${selection}/PKGBUILD")
fi

if [[ ! "${selection}" =~ ^[a-z0-9@._+-]+$ || ! -f "${pkgbuilds[0]}" ]]; then
    printf 'error: package not found: %s\n' "${selection}" >&2
    exit 1
fi

[[ "$(git -C "${root}" branch --show-current)" == main ]] || {
    printf 'error: releases must run from main\n' >&2
    exit 1
}

[[ -z "$(git -C "${root}" status --porcelain)" ]] || {
    printf 'error: releases require a clean worktree\n' >&2
    exit 1
}

verify_signature() {
    gpg --batch --status-fd 1 --verify "$1.sig" "$1" |
        awk -v key="${signing_key}" '
            $1 == "[GNUPG:]" && $2 == "VALIDSIG" &&
                (toupper($3) == key || toupper($NF) == key) {
                valid = 1
            }
            END { exit !valid }
        '
}

rm -rf "${repo_root}"
mkdir -p "${repo_dir}" "${PKGDEST}"

rclone copy "${remote_dir}" "${repo_dir}" \
    --include '*.pkg.tar.*'

package_name() {
    bsdtar -xOf "$1" .PKGINFO |
        awk -F ' = ' -v filename="${1##*/}" '
            $1 == "pkgname" { name = $2 }
            $1 == "pkgver" { version = $2 }
            $1 == "arch" { arch = $2 }
            END {
                sub(/^[0-9]+:/, "", version)
                if (name == "" || version == "" || arch == "" ||
                    index(filename, name "-" version "-" arch ".pkg.tar.") != 1) {
                    printf "error: package identity does not match filename: %s\n", filename > "/dev/stderr"
                    exit 1
                }
                print name
            }
        '
}

shopt -s nullglob
existing_packages=("${repo_dir}"/*.pkg.tar.*)

if [[ "${selection}" != all && ${#existing_packages[@]} -eq 0 ]]; then
    printf 'error: run release all to initialize the repository\n' >&2
    exit 1
fi

for existing in "${existing_packages[@]}"; do
    [[ "${existing}" == *.sig ]] && continue
    verify_signature "${existing}"
done

declare -A release_files=()
for pkgbuild in "${pkgbuilds[@]}"; do
    package_dir="${pkgbuild%/*}"
    diff -u "${package_dir}/.SRCINFO" <(cd "${package_dir}" && makepkg --printsrcinfo)
    package_list="$(cd "${pkgbuild%/*}" && makepkg --packagelist)"
    build_needed=0
    while IFS= read -r package_file; do
        [[ -f "${repo_dir}/${package_file##*/}" ]] || build_needed=1
    done <<< "${package_list}"

    if (( build_needed )); then
        "${root}/scripts/build" "${package_dir##*/}"
    fi

    while IFS= read -r package_file; do
        published_file="${repo_dir}/${package_file##*/}"
        if [[ -f "${published_file}" ]]; then
            printf '==> Reusing published package: %s\n' "${package_file##*/}"
        else
            gpg --batch --yes --detach-sign \
                --local-user "${signing_key}" \
                "${package_file}"
            verify_signature "${package_file}"
            install -m644 "${package_file}" "${package_file}.sig" "${repo_dir}/"
        fi
        release_files["${published_file}"]=1
        name="$(package_name "${published_file}")"
        for existing in "${existing_packages[@]}"; do
            [[ "${existing}" == *.sig ]] && continue
            [[ "${existing}" == "${published_file}" ]] && continue
            [[ -f "${existing}" ]] || continue
            if [[ "$(package_name "${existing}")" == "${name}" ]]; then
                rm -f "${existing}" "${existing}.sig"
            fi
        done
    done <<< "${package_list}"
done

gpg --batch --armor --export "${signing_key}" > "${repo_root}/${repo_name}.asc"

repo_packages=("${repo_dir}"/*.pkg.tar.*)

package_files=()
for package_file in "${repo_packages[@]}"; do
    [[ "${package_file}" == *.sig ]] && continue
    if [[ "${selection}" == all && ${release_files["${package_file}"]:-0} == 0 ]]; then
        rm -f "${package_file}" "${package_file}.sig"
        continue
    fi
    package_files+=("${package_file}")
done

repo-add \
    --include-sigs \
    --sign \
    --key "${signing_key}" \
    "${repo_dir}/${repo_name}.db.tar.zst" \
    "${package_files[@]}"

verify_signature "${repo_dir}/${repo_name}.db.tar.zst"
verify_signature "${repo_dir}/${repo_name}.files.tar.zst"

rclone copyto \
    "${repo_root}/${repo_name}.asc" \
    "${repo_remote}/${repo_name}.asc" \
    --checksum

rclone copy "${repo_dir}" "${remote_dir}" \
    --checksum \
    --immutable \
    --include '*.pkg.tar.*'

rclone copy "${repo_dir}" "${remote_dir}" \
    --checksum \
    --copy-links \
    --include "${repo_name}.db*" \
    --include "${repo_name}.files*"

rclone sync "${repo_dir}" "${remote_dir}" \
    --checksum \
    --immutable \
    --include '*.pkg.tar.*'

printf '==> Released: %s\n' "${selection}"
