#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=/dev/null
source "${root}/scripts/common"

# shellcheck source=/dev/null
source "${root}/config/repo.conf"

[[ $# -eq 0 ]] || {
    printf 'Usage: %s\n' "$(basename "$0")" >&2
    exit 2
}

acquire_repository_lock "${root}"

fingerprint="${REPO_SIGNING_KEY^^}"
remote_root="${REPO_REMOTE%/}"
repo_root="${root}/repo"
repo_dir="${repo_root}/${REPO_ARCH}"
database="${repo_dir}/${REPO_NAME}.db.tar.zst"
public_key="${repo_root}/${REPO_NAME}.asc"
remote_repo="${remote_root}/${REPO_ARCH}"

[[ -f "${database}" && ! -L "${database}" ]] || {
    printf 'error: repository database not found: %s\n' "${database}" >&2
    exit 1
}

[[ -f "${public_key}" && ! -L "${public_key}" ]] || {
    printf 'error: repository public key not found: %s\n' "${public_key}" >&2
    exit 1
}

database_size="$(stat --format='%s' "${database}")"
(( database_size <= REPO_MAX_DATABASE_BYTES )) || {
    printf 'error: local repository database exceeds size limit\n' >&2
    exit 1
}

if ! key_listing="$(
    gpg --batch --with-colons --show-keys "${public_key}" 2>&1
)"; then
    printf 'error: could not read repository public key: %s\n' \
        "${public_key}" >&2
    printf '%s\n' "${key_listing}" >&2
    exit 1
fi

key_fingerprints="$(
    awk -F: '
        $1 == "pub" { primary = 1; next }
        primary && $1 == "fpr" { print toupper($10); primary = 0 }
    ' <<< "${key_listing}"
)"

grep -Fqx "${fingerprint}" <<< "${key_fingerprints}" || {
    printf 'error: public key does not contain signing fingerprint: %s\n' \
        "${fingerprint}" >&2
    exit 1
}

database_field() {
    local source_database="$1"
    local field="$2"
    local entry
    local entries
    local record_count=0
    local value

    entries="$(
        bounded_archive_listing \
            "${source_database}" \
            "${REPO_MAX_DATABASE_ENTRIES}"
    )" || return 1

    while IFS= read -r entry; do
        [[ "${entry}" == */desc ]] || continue
        (( ++record_count <= REPO_MAX_PACKAGE_RECORDS )) || return 1

        value="$(
            bsdtar -xOf "${source_database}" "${entry}" |
                awk -v marker="%${field}%" '
                    $0 == marker { getline; print; exit }
                '
        )"

        [[ -n "${value}" ]] || return 1
        printf '%s\n' "${value}"
    done <<< "${entries}"
}

database_records() {
    local source_database="$1"
    local entry
    local entries
    local package_name
    local package_version
    local record_count=0

    entries="$(
        bounded_archive_listing \
            "${source_database}" \
            "${REPO_MAX_DATABASE_ENTRIES}"
    )" || return 1

    while IFS= read -r entry; do
        [[ "${entry}" == */desc ]] || continue
        (( ++record_count <= REPO_MAX_PACKAGE_RECORDS )) || return 1

        package_name="$(
            bsdtar -xOf "${source_database}" "${entry}" |
                awk '
                    $0 == "%NAME%" { getline; print; exit }
                '
        )"

        package_version="$(
            bsdtar -xOf "${source_database}" "${entry}" |
                awk '
                    $0 == "%VERSION%" { getline; print; exit }
                '
        )"

        [[ -n "${package_name}" && -n "${package_version}" ]] || return 1
        printf '%s\t%s\n' "${package_name}" "${package_version}"
    done <<< "${entries}"
}

verify_package_signature() {
    local artifact="$1"
    local signature="${artifact}.sig"
    local signature_status
    local signer

    [[ -f "${signature}" && ! -L "${signature}" ]] || {
        printf 'error: package signature missing: %s\n' "${signature}" >&2
        return 1
    }

    if ! signature_status="$(
        gpg --batch --status-fd 1 \
            --verify "${signature}" "${artifact}" 2>/dev/null
    )"; then
        printf 'error: invalid repository package signature: %s\n' \
            "${signature}" >&2
        return 1
    fi

    signer="$(
        awk '$1 == "[GNUPG:]" && $2 == "VALIDSIG" { print toupper($NF); exit }' \
            <<< "${signature_status}"
    )"

    [[ "${signer}" == "${fingerprint}" ]] || {
        printf 'error: package signature is not valid for %s: %s\n' \
            "${fingerprint}" "${signature}" >&2
        return 1
    }
}

if ! local_records="$(database_records "${database}" | sort -u)"; then
    printf 'error: local repository database is unreadable\n' >&2
    exit 1
fi

if ! local_files="$(database_field "${database}" FILENAME | sort -u)"; then
    printf 'error: local repository database is unreadable\n' >&2
    exit 1
fi

if ! database_field "${database}" PGPSIG >/dev/null; then
    printf 'error: local repository database contains unsigned entries\n' >&2
    exit 1
fi

local_names="$(awk -F '\t' '{ print $1 }' <<< "${local_records}")"

[[ -n "${local_records}" && -n "${local_files}" ]] || {
    printf 'error: local repository database is empty or unreadable\n' >&2
    exit 1
}

while IFS= read -r package_file; do
    [[ "${package_file}" == "$(basename "${package_file}")" ]] || {
        printf 'error: database contains an invalid artifact filename: %s\n' \
            "${package_file}" >&2
        exit 1
    }

    artifact="${repo_dir}/${package_file}"
    signature="${artifact}.sig"

    [[ -f "${artifact}" && ! -L "${artifact}" ]] || {
        printf 'error: database advertises missing artifact: %s\n' "${artifact}" >&2
        exit 1
    }

    [[ -f "${signature}" ]] || {
        printf 'error: database advertises unsigned artifact: %s\n' "${artifact}" >&2
        exit 1
    }

    verify_package_signature "${artifact}" || exit 1
done <<< "${local_files}"

set +e
remote_listing="$(
    rclone lsf "${remote_repo}/" --max-depth 1 --files-only 2>&1 |
        LC_ALL=C awk -v max_bytes="${REPO_MAX_REMOTE_LISTING_BYTES}" '
            { bytes += length($0) + 1 }
            bytes > max_bytes { exit 1 }
            { print }
        '
)"
remote_status=$?
set -e

case "${remote_status}" in
    0)
        ;;
    3)
        remote_listing=''
        ;;
    *)
        printf 'error: cannot read remote repository (rclone status %d)\n' \
            "${remote_status}" >&2
        printf '%s\n' "${remote_listing}" >&2
        exit 1
        ;;
esac

(( ${#remote_listing} <= REPO_MAX_REMOTE_LISTING_BYTES )) || {
    printf 'error: remote repository listing exceeds size limit\n' >&2
    exit 1
}

if grep -Fqx "${REPO_NAME}.db.tar.zst" <<< "${remote_listing}"; then
    remote_database_dir="$(mktemp -d)"
    remote_database="${remote_database_dir}/${REPO_NAME}.db.tar.zst"
    trap 'rm -rf "${remote_database_dir}"' EXIT

    if ! rclone copy \
        "${remote_repo}" \
        "${remote_database_dir}" \
        --max-depth 1 \
        --include "${REPO_NAME}.db.tar.zst" \
        --max-size "${REPO_MAX_DATABASE_BYTES}B"
    then
        printf 'error: could not download remote repository database\n' >&2
        exit 1
    fi

    [[ -f "${remote_database}" ]] || {
        printf 'error: remote repository database exceeds size limit\n' >&2
        exit 1
    }

    remote_database_size="$(stat --format='%s' "${remote_database}")"
    (( remote_database_size > 0 && remote_database_size <= REPO_MAX_DATABASE_BYTES )) || {
        printf 'error: remote repository database exceeds size limit\n' >&2
        exit 1
    }

    if ! remote_records="$(database_records "${remote_database}" | sort -u)"; then
        printf 'error: remote repository database is unreadable\n' >&2
        exit 1
    fi

    remote_names="$(awk -F '\t' '{ print $1 }' <<< "${remote_records}")"

    [[ -n "${remote_records}" ]] || {
        printf 'error: remote repository database is empty or unreadable\n' >&2
        exit 1
    }

    hidden_packages="$(
        comm -23 \
            <(printf '%s\n' "${remote_names}") \
            <(printf '%s\n' "${local_names}")
    )"

    if [[ -n "${hidden_packages}" ]]; then
        printf '%s\n' \
            'error: local database would hide remote packages:' >&2

        while IFS= read -r package_name; do
            printf '  %s\n' "${package_name}" >&2
        done <<< "${hidden_packages}"

        exit 1
    fi

    while IFS=$'\t' read -r package_name remote_version; do
        local_version="$(
            awk -F '\t' -v name="${package_name}" \
                '$1 == name { print $2; exit }' <<< "${local_records}"
        )"

        [[ -n "${local_version}" ]] || continue

        version_order="$(vercmp "${local_version}" "${remote_version}")"

        if (( version_order < 0 )); then
            printf 'error: local %s version %s is older than remote version %s\n' \
                "${package_name}" "${local_version}" "${remote_version}" >&2
            exit 1
        fi
    done <<< "${remote_records}"
fi

shopt -s nullglob
retained_artifacts=("${repo_dir}"/*.pkg.tar.*)
shopt -u nullglob

for artifact in "${retained_artifacts[@]}"; do
    [[ "${artifact}" != *.sig ]] || continue
    [[ ! -L "${artifact}" ]] || {
        printf 'error: retained artifact must not be a symlink: %s\n' \
            "${artifact}" >&2
        exit 1
    }
    artifact_size="$(stat --format='%s' "${artifact}")"
    (( artifact_size <= REPO_MAX_ARTIFACT_BYTES )) || {
        printf 'error: retained artifact exceeds size limit: %s\n' \
            "${artifact}" >&2
        exit 1
    }
    verify_package_signature "${artifact}" || exit 1
done

printf '==> Publishing public key\n'

rclone copyto \
    "${public_key}" \
    "${remote_root}/${REPO_NAME}.asc" \
    --checksum \
    --immutable

printf '==> Publishing packages and signatures\n'

if ! rclone copy \
    "${repo_dir}" \
    "${remote_repo}" \
    --checksum \
    --include '*.pkg.tar.*' \
    --max-size "${REPO_MAX_ARTIFACT_BYTES}B" \
    --max-transfer "${REPO_MAX_UPLOAD_BYTES}B" \
    --immutable
then
    printf '%s\n' \
        'error: package upload failed; repository database was not published' >&2
    exit 1
fi

printf '==> Publishing repository database\n'

rclone copy \
    "${repo_dir}" \
    "${remote_repo}" \
    --checksum \
    --copy-links \
    --filter "+ ${REPO_NAME}.db*" \
    --filter "+ ${REPO_NAME}.files*" \
    --filter '- *'

printf '==> Pruning remote package history\n'

if ! rclone sync \
    "${repo_dir}" \
    "${remote_repo}" \
    --checksum \
    --immutable \
    --check-first \
    --max-transfer "${REPO_MAX_UPLOAD_BYTES}B" \
    --max-delete "${REPO_MAX_REMOTE_DELETES}" \
    --max-delete-size "${REPO_MAX_REMOTE_DELETE_BYTES}B" \
    --include '*.pkg.tar.*'
then
    printf '%s\n' \
        'error: repository published but remote artifact pruning failed' >&2
    exit 1
fi

printf '==> Published: %s/%s\n' "${REPO_BASE_URL}" "${REPO_ARCH}"
